{
  "_comment": [
    "xtcli STM32 设备数据表 —— 只放数据, 不放逻辑。新增芯片/系列只改这里。",
    "families: 由型号前缀 (STM32F1 / STM32H7 ...) 匹配, 提供 CPU/FPU 与 openocd target。",
    "cproject 里只写了 target_mcu, 没有 -mcpu/-mfpu, 所以这里必须补齐。",
    "density: 由型号里的容量代码推导 HAL 密度宏 (CubeMX 的 STM32F103RCTx -> STM32F103xE)。"
  ],
  "families": {
    "STM32C0": { "cpu": "cortex-m0plus", "fpu": "", "ocd": "target/stm32c0x.cfg" },
    "STM32F0": { "cpu": "cortex-m0",     "fpu": "", "ocd": "target/stm32f0x.cfg" },
    "STM32F1": { "cpu": "cortex-m3",     "fpu": "-mfloat-abi=soft", "ocd": "target/stm32f1x.cfg" },
    "STM32F2": { "cpu": "cortex-m3",     "fpu": "-mfloat-abi=soft", "ocd": "target/stm32f2x.cfg" },
    "STM32F3": { "cpu": "cortex-m4",     "fpu": "-mfpu=fpv4-sp-d16 -mfloat-abi=hard", "ocd": "target/stm32f3x.cfg" },
    "STM32F4": { "cpu": "cortex-m4",     "fpu": "-mfpu=fpv4-sp-d16 -mfloat-abi=hard", "ocd": "target/stm32f4x.cfg" },
    "STM32F7": { "cpu": "cortex-m7",     "fpu": "-mfpu=fpv5-sp-d16 -mfloat-abi=hard", "ocd": "target/stm32f7x.cfg" },
    "STM32G0": { "cpu": "cortex-m0plus", "fpu": "", "ocd": "target/stm32g0x.cfg" },
    "STM32G4": { "cpu": "cortex-m4",     "fpu": "-mfpu=fpv4-sp-d16 -mfloat-abi=hard", "ocd": "target/stm32g4x.cfg" },
    "STM32H5": { "cpu": "cortex-m33",    "fpu": "-mfpu=fpv5-sp-d16 -mfloat-abi=hard", "ocd": "target/stm32h5x.cfg" },
    "STM32H7": { "cpu": "cortex-m7",     "fpu": "-mfpu=fpv5-d16 -mfloat-abi=hard",    "ocd": "target/stm32h7x.cfg" },
    "STM32L0": { "cpu": "cortex-m0plus", "fpu": "", "ocd": "target/stm32l0.cfg" },
    "STM32L1": { "cpu": "cortex-m3",     "fpu": "-mfloat-abi=soft", "ocd": "target/stm32l1.cfg" },
    "STM32L4": { "cpu": "cortex-m4",     "fpu": "-mfpu=fpv4-sp-d16 -mfloat-abi=hard", "ocd": "target/stm32l4x.cfg" },
    "STM32L5": { "cpu": "cortex-m33",    "fpu": "-mfpu=fpv5-sp-d16 -mfloat-abi=hard", "ocd": "target/stm32l5x.cfg" },
    "STM32U5": { "cpu": "cortex-m33",    "fpu": "-mfpu=fpv5-sp-d16 -mfloat-abi=hard", "ocd": "target/stm32u5x.cfg" },
    "STM32WB": { "cpu": "cortex-m4",     "fpu": "-mfpu=fpv4-sp-d16 -mfloat-abi=hard", "ocd": "target/stm32wbx.cfg" },
    "STM32WL": { "cpu": "cortex-m4",     "fpu": "-mfpu=fpv4-sp-d16 -mfloat-abi=soft", "ocd": "target/stm32wlx.cfg" }
  },

  "_density_comment": [
    "容量代码位置因系列而异, 这里按 F1 的约定: 型号第 4 段首字母 (STM32F103RCTx -> C)。",
    "只作为 .cproject/.ewp 里没有现成宏时的兜底推导; 有现成宏时一律以现成宏为准。"
  ],
  "density": {
    "STM32F1": {
      "4": "x6", "6": "x6",
      "8": "x8", "B": "xB",
      "C": "xE", "D": "xE", "E": "xE",
      "F": "xF", "G": "xG"
    }
  },

  "flashBase": "0x08000000",

  "_probe_comment": "openocd interface 配置; doctor/burn 的默认探测顺序。",
  "probes": [
    { "name": "stlink",   "cfg": "interface/stlink.cfg" },
    { "name": "cmsis-dap","cfg": "interface/cmsis-dap.cfg" },
    { "name": "jlink",    "cfg": "interface/jlink.cfg" }
  ]
}
